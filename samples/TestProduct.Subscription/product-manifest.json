      "code": "standard",
      "name": "Standard",
      "displayName": "Стандартный (Monthly)",
      "tier": "Pro",
      "billingModel": "Subscription",
      "billingPeriod": "Monthly",
      "licenseMode": "User",
      "monthlyPrice": 990,
      "yearlyPrice": null,
      "oneTimePrice": null,
      "currency": "RUB",
      "maxSeats": 1,
      "maxConcurrentSessions": null,
      "trialDays": 14,
      "trialBindingMode": "Account",
      "isActive": true
    },
    {
      "code": "standard-yearly",
      "name": "Standard Yearly",
      "displayName": "Стандартный (Yearly)",
      "tier": "Pro",
      "billingModel": "Subscription",
      "billingPeriod": "Yearly",
      "licenseMode": "User",
      "monthlyPrice": null,
      "yearlyPrice": 9900,
      "oneTimePrice": null,
      "currency": "RUB",
      "maxSeats": 1,
      "maxConcurrentSessions": null,
