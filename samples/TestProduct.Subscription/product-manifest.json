  "features": [
    {
      "code": "basic",
      "name": "Базовый функционал",
      "description": "Основные инструменты продукта",
      "isDefault": true,
      "isPublic": false
    },
    {
      "code": "export",
      "name": "Экспорт",
      "description": "Экспорт данных в различные форматы",
      "isDefault": false,
      "isPublic": false
    },
    {
      "code": "advanced-export",
      "name": "Расширенный экспорт",
      "description": "Пакетный экспорт, шаблоны, автоматизация",
      "isDefault": false,
      "isPublic": false
    },
    {
      "code": "batch",
      "name": "Пакетная обработка",
      "description": "Пакетная обработка нескольких файлов",
      "isDefault": false,
      "isPublic": false
    }
  ],

  "planFeatures": {
    "standard": ["basic", "export"],
    "standard-yearly": ["basic", "export"],
    "pro": ["basic", "export", "advanced-export", "batch"]
  },

  "featureLimits": {
    "standard.export": [
      {
        "limitCode": "monthlyExports",
        "limitType": "MaxPerPeriod",
        "limitValue": 100
      }
    ],
    "standard-yearly.export": null,
    "pro.export": null
  },

  "releases": [
    {
      "version": "1.0.0",
      "channel": "Stable",
      "changelog": "Первый релиз. Standard и Pro планы, Trial 14 дней.",
      "distributionType": "Bundle",
      "postInstallAction": "RequireRestart",
      "netloadDllPath": "Contents/TestProduct.Subscription.dll",
      "minAutoCADVersion": "R24.4",
      "maxAutoCADVersion": "R25.0",
      "targetPlatforms": ["AutoCAD", "Civil3D"],
      "supportedOS": ["Win64"],
      "loadOnStartup": true,
      "fixtureFile": "fixtures/TestProduct.Subscription.v1.0.0.bundle.zip"
    },
    {
      "version": "1.1.0",
      "channel": "Stable",
      "changelog": "Добавлен Yearly план, новая feature в Pro, MaxPerPeriod limit для экспорта.",
      "distributionType": "Bundle",
      "postInstallAction": "RequireRestart",
      "netloadDllPath": "Contents/TestProduct.Subscription.dll",
      "minAutoCADVersion": "R24.4",
      "maxAutoCADVersion": "R25.0",
      "targetPlatforms": ["AutoCAD", "Civil3D"],
      "supportedOS": ["Win64"],
      "loadOnStartup": true,
      "fixtureFile": "fixtures/TestProduct.Subscription.v1.1.0.bundle.zip"
    }
  ],

  "expectations": {
    "sdkInit": {
      "isValid": true,
      "expectedPlanTier": "Pro",
      "expectedBillingModel": "Subscription"
    },
    "trial": {
      "isAvailable": true,
      "trialDays": 14,
      "trialBindingMode": "Account"
    },
    "commands": [
      {
        "name": "GGSUBSTEST",
        "expectedOutput": "Subscription plugin executed",
        "requiresLicense": true
      },
      {
        "name": "GGSUBSINFO",
        "expectedOutput": "PlanTier=Pro",
        "requiresLicense": false
      },
      {
        "name": "GGSUBSEXPORT",
        "expectedOutput": "Export completed",
        "requiresLicense": true
      },
      {
        "name": "GGSUBSBATCH",
        "expectedOutput": "Batch processing",
        "requiresLicense": true
      }
    ]
  }
