<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LGC-1052: у этого образца настроек нет ПО ЗАМЫСЛУ — он раздаётся голой DLL, а не
         бандлом с ключом (в реестре build-samples.ps1 он объявлен HasSettings = $false).
         Выключено объявлением, а не выведено из имени: порождение по умолчанию включено, и
         тихое исключение по названию проекта было бы признаком-заместителем. -->
    <GenerateGrossGeoSettings>false</GenerateGrossGeoSettings>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <RootNamespace>TestProduct.PluginDll</RootNamespace>
    <AssemblyName>TestProduct.PluginDll</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Product Info -->
    <Version>1.0.0</Version>
    <Authors>GrossGeo Test</Authors>
    <Product>Test Product PluginDll</Product>
    <Description>Тестовый PluginDll продукт — одиночная DLL без bundle</Description>
    
    <!-- Output -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- GrossGeo SDK.Stub Reference -->
  <ItemGroup>
    <PackageReference Include="GrossGeo.SDK.Stub" Version="2.1.17" />
  </ItemGroup>

  <!-- AutoCAD References for .NET 8 (AutoCAD 2025+) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="accoremgd">
      <HintPath>$(AcadRefDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadRefDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadRefDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadRefDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Build Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
