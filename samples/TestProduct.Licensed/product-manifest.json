  "expectations": {
    "sdkInit": {
      "isValid": true,
      "expectedPlanTier": "Pro",
      "expectedBillingModel": "Perpetual"
    },
    "maintenanceLifecycle": {
      "withActiveMaintenance": {
        "canUpdate": true,
        "latestVersion": "1.1.0"
      },
      "withExpiredMaintenance": {
        "canUpdate": false,
        "versionLockedAt": "1.0.0"
      },
      "withoutMaintenance": {
        "canUpdate": false,
        "noUpdateAvailable": true
      }
    },
    "commands": [
      {
        "name": "TEST_LICENSE_INFO",
        "expectedOutput": "PlanTier=Pro",
        "requiresLicense": false
      },
      {
        "name": "TEST_PROTECTED_CMD",
        "expectedOutput": "Лицензия валидна",
        "requiresLicense": true
      },
      {
        "name": "TEST_FEATURE_CHECK",
        "expectedOutput": "export_pdf",
        "requiresLicense": false
      },
      {
        "name": "TEST_CHECK_UPDATE",
        "expectedOutput": "Проверка обновлений",
        "requiresLicense": false
      },
      {
        "name": "TEST_LICENSE_RECHECK",
        "expectedOutput": "Повторная проверка",
        "requiresLicense": false
      },
      {
        "name": "TEST_LICENSED_HELP",
        "expectedOutput": "TEST PRODUCT LICENSED",
