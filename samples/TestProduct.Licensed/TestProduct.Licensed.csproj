<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>TestProduct.Licensed</RootNamespace>
    <AssemblyName>TestProduct.Licensed</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Product Info -->
    <Version>1.0.0</Version>
    <Authors>GrossGeo Test</Authors>
    <Product>Test Product Licensed</Product>
    <Description>Тестовый продукт для проверки платформы дистрибуции GrossGeo с полным SDK (лицензирование)</Description>

    <!-- Output -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- GrossGeo SDK.Stub Reference (NuGet Package) -->
  <ItemGroup>
    <PackageReference Include="GrossGeo.SDK.Stub" Version="2.2.3" />
  </ItemGroup>

  <!-- AutoCAD References for .NET Framework 4.8 (AutoCAD 2019-2024) via NuGet -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.3.0" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET.Core" Version="24.3.0" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET.Model" Version="24.3.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- AutoCAD References for .NET 8 (AutoCAD 2025+) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="accoremgd">
      <HintPath>$(AcadRefDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadRefDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadRefDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadRefDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Build Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
