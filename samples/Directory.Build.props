<Project>
  <!--
    Общие свойства для тестовых AutoCAD плагинов GrossGeo.
    
    AutoCAD начиная с версии 2019 является ТОЛЬКО 64-битным приложением.
    Поэтому все плагины должны компилироваться для x64 архитектуры.
    
    Это устраняет предупреждение MSB3270 о несоответствии архитектур
    между проектом (MSIL/AnyCPU) и ссылками на AutoCAD DLL (AMD64).
  -->
  
  <PropertyGroup>
    <!-- AutoCAD 64-bit only - обязательно для корректной работы плагинов -->
    <PlatformTarget>x64</PlatformTarget>
    
    <!-- MSB3277 подавлен ЦЕЛИКОМ. Это не «конфликтов нет» (LGC-1404):
         - свойство берёт только код, не сборку, поэтому глушится ЛЮБОЙ конфликт версий, в том числе
           System.Management (AutoCAD 2025 несёт 4.0.0.0, SDK.Stub просит 8.0.0.0);
         - эталон — сборка без подавления против AutoCAD 2025: 8 из 8 образцов, 2 конфликта,
           оба у net8-ноги, оба сборки общей среды — Microsoft.VisualBasic 10.0↔10.1 и System.Drawing 4.0↔8.0
           (832 строки в журнале — поэтому подавление и вернули: такой шум топит новое предупреждение);
         - System.Management в замыкание ссылок образцов не входит (AcWindows/DasClient не тянутся),
           так что эта сборка замером для LGC-1358 (Б) не является.
         Новый конфликт здесь невидим, пока нет сторожа сверки с эталоном (2 имени). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <!-- LGC-1050: путь к управляемому API AutoCAD ВЫНЕСЕН В СВОЙСТВО и переопределяем.

         Было: у каждой из восьми ссылок абсолютный HintPath на C:\Program Files\Autodesk\AutoCAD 2025.
         Образцы существуют ровно затем, чтобы их собирал посторонний; у него этого пути
         может не быть, и он получал отказ компилятора об отсутствующих типах — сообщение,
         по которому причину не найти.

         Мы этого не видим ПО ПОСТРОЕНИЮ: у нас AutoCAD установлен, и любой наш прогон
         зелен независимо от дефекта. Поэтому признак приёмки — сборка с переопределённым
         путём на несуществующий каталог; она обязана падать ВНЯТНО, а не молча.
    -->
    <AcadRefDir Condition="'$(AcadRefDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AcadRefDir>
    <AcadRefDir48 Condition="'$(AcadRefDir48)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AcadRefDir48>
  </PropertyGroup>

</Project>
