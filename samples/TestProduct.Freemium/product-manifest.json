      "distributionType": "Bundle",
      "postInstallAction": "RequireRestart",
      "netloadDllPath": "Contents/TestProduct.Freemium.dll",
      "minAutoCADVersion": "R24.4",
      "maxAutoCADVersion": "R25.0",
      "targetPlatforms": ["AutoCAD", "Civil3D"],
      "supportedOS": ["Win64"],
      "loadOnStartup": true,
