      "postInstallAction": "RequireRestart",
      "netloadDllPath": "Contents/TestProduct.Concurrent.dll",
      "minAutoCADVersion": "R24.4",
      "maxAutoCADVersion": "R25.0",
      "targetPlatforms": ["AutoCAD", "Civil3D"],
      "supportedOS": ["Win64"],
      "loadOnStartup": true,
      "fixtureFile": "fixtures/TestProduct.Concurrent.v1.0.0.bundle.zip"
    },
    {
      "version": "1.1.0",
      "channel": "Stable",
      "changelog": "Graduated limits, session timeout тест, MaxPerSession.",
      "distributionType": "Bundle",
      "postInstallAction": "RequireRestart",
      "netloadDllPath": "Contents/TestProduct.Concurrent.dll",
      "minAutoCADVersion": "R24.4",
      "maxAutoCADVersion": "R25.0",
      "targetPlatforms": ["AutoCAD", "Civil3D"],
      "supportedOS": ["Win64"],
      "loadOnStartup": true,
      "fixtureFile": "fixtures/TestProduct.Concurrent.v1.1.0.bundle.zip"
    }
  ],

  "expectations": {
    "sdkInit": {
      "isValid": true,
      "expectedPlanTier": "Free",
      "expectedBillingModel": "Free"
    },
    "trial": {
      "proTrial": {
        "isAvailable": true,
        "trialDays": 7,
        "trialBindingMode": "Account"
      },
      "proPlusTrial": {
        "isAvailable": true,
        "trialDays": 7,
        "trialBindingMode": "Account"
      }
    },
    "concurrentSessions": {
      "sessionTimeout": {
        "missedHeartbeats": 3,
        "graceMinutes": 15,
        "shouldRelease": true
      },
      "forceRelease": {
        "ownerCanRelease": true,
        "adminCanRelease": true
      },
      "maxSeatsEnforcement": {
        "maxSeats": 10,
        "shouldRejectAt": 11
      }
    },
    "graduatedLimits": {
      "export-batch.maxPerCall": {
        "free": 10,
        "pro": 100,
        "pro-plus": null
      }
    },
    "commands": [
      {
        "name": "GGCONCINFO",
        "expectedOutput": "PlanTier=Free",
        "requiresLicense": false
      },
      {
        "name": "GGCONCSESSION",
        "expectedOutput": "Session acquired",
        "requiresLicense": true
      },
      {
        "name": "GGCONCSESSIONRELEASE",
        "expectedOutput": "Session released",
        "requiresLicense": true
      },
      {
        "name": "GGCONCPUBLIC",
        "expectedOutput": "view-objects",
        "requiresLicense": false
      },
      {
        "name": "GGCONCPRO",
        "expectedOutput": "pro-tools",
        "requiresLicense": true
      },
      {
        "name": "GGCONCBATCH",
        "expectedOutput": "export-batch",
        "requiresLicense": true
      },
      {
        "name": "GGCONCLIMITS",
        "expectedOutput": "Feature Limits",
        "requiresLicense": false
      },
      {
        "name": "GGCONCHELP",
        "expectedOutput": "TEST PRODUCT CONCURRENT",
        "requiresLicense": false
      }
    ]
  }
