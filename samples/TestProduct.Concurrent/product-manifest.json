        "limitCode": "maxPerSession",
        "limitType": "MaxPerSession",
        "limitValue": 500
      }
    ],
    "pro-plus.export-batch": null,

    "pro.pro-tools": [
      {
        "limitCode": "maxPerSession",
        "limitType": "MaxPerSession",
        "limitValue": 50
      }
    ],
    "pro-plus.pro-tools": null,

    "pro-plus.cloud-sync": [
      {
        "limitCode": "maxSize",
        "limitType": "MaxSize",
        "limitValue": 104857600
      }
    ]
