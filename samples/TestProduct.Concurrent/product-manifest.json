    "pro-plus": ["view-objects", "basic-tools", "pro-tools", "export-batch", "enterprise-api", "cloud-sync"]
  },

  "featureLimits": {
    "free.export-batch": [
      {
        "limitCode": "maxPerCall",
        "limitType": "MaxPerCall",
        "limitValue": 10
      }
    ],
    "pro.export-batch": [
      {
        "limitCode": "maxPerCall",
        "limitType": "MaxPerCall",
        "limitValue": 100
