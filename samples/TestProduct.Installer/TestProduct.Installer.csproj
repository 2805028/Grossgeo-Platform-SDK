<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <RootNamespace>TestProduct.Installer</RootNamespace>
    <AssemblyName>TestProduct.Installer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Product Info -->
    <Version>1.0.0</Version>
    <Authors>GrossGeo Test</Authors>
    <Product>Test Product Installer</Product>
    <Description>Р СћР ВµРЎРѓРЎвЂљР С•Р Р†РЎвЂ№Р в„– Р С—РЎР‚Р С•Р Т‘РЎС“Р С”РЎвЂљ РЎРѓ РЎвЂљР С‘Р С—Р С•Р С Р Т‘Р С‘РЎРѓРЎвЂљРЎР‚Р С‘Р В±РЎС“РЎвЂ Р С‘Р С‘ Installer (MSI/EXE)</Description>
    
    <!-- Output -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- StubInstaller РІР‚вЂќ Р С•РЎвЂљР Т‘Р ВµР В»РЎРЉР Р…РЎвЂ№Р в„– Р С—РЎР‚Р С•Р ВµР С”РЎвЂљ Р Р†Р Р…РЎС“РЎвЂљРЎР‚Р С‘ Р Т‘Р С‘РЎР‚Р ВµР С”РЎвЂљР С•РЎР‚Р С‘Р С‘, Р С‘РЎРѓР С”Р В»РЎР‹РЎвЂЎР В°Р ВµР С Р С‘Р В· РЎР‚Р ВµР С”РЎС“РЎР‚РЎРѓР С‘Р Р†Р Р…Р С•Р С–Р С• glob -->
  <ItemGroup>
    <Compile Remove="StubInstaller\**" />
    <None Remove="StubInstaller\**" />
    <EmbeddedResource Remove="StubInstaller\**" />
  </ItemGroup>

  <!-- GrossGeo SDK.Stub from NuGet (GrossGeo.Contracts types are embedded in the package). -->
  <ItemGroup>
    <PackageReference Include="GrossGeo.SDK.Stub" Version="2.1.15" />
  </ItemGroup>

  <!-- AutoCAD References for .NET 8 (AutoCAD 2025+) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="accoremgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Build Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
