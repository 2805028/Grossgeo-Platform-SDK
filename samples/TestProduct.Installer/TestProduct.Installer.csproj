<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LGC-1052: grossgeo-settings.json здесь порождает СОБСТВЕННЫЙ генератор образца
         (MsiInstaller/generate-bundle-inputs.ps1, цель GenerateMsiBundleInputs): он пишет и
         PackageContents.xml, и настройки, из того же private const ProductKey. Общее
         порождение выключено не потому, что мешает — содержимое вышло бы то же, — а чтобы у
         файла был ОДИН хозяин: иначе следующий, меняя один генератор, не найдёт второго. -->
    <GenerateGrossGeoSettings>false</GenerateGrossGeoSettings>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <RootNamespace>TestProduct.Installer</RootNamespace>
    <AssemblyName>TestProduct.Installer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Product Info -->
    <Version>1.0.0</Version>
    <Authors>GrossGeo Test</Authors>
    <Product>Test Product Installer</Product>
    <Description>Тестовый продукт с типом дистрибуции Installer (MSI)</Description>
    
    <!-- Output -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- MsiInstaller — WiX-проект внутри директории, исключаем из рекурсивного glob -->
  <ItemGroup>
    <Compile Remove="MsiInstaller\**" />
    <None Remove="MsiInstaller\**" />
    <EmbeddedResource Remove="MsiInstaller\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="MsiInstaller\License.rtf" />
    <None Include="MsiInstaller\MsiInstaller.wixproj" />
  </ItemGroup>

  <!-- GrossGeo SDK.Stub Reference -->
  <ItemGroup>
    <PackageReference Include="GrossGeo.SDK.Stub" Version="2.1.17" />
  </ItemGroup>

  <!-- AutoCAD References for .NET 8 (AutoCAD 2025+) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="accoremgd">
      <HintPath>$(AcadRefDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadRefDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadRefDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadRefDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Build Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    LGC-759: два входа сборки MSI порождаются здесь, и ТОЛЬКО у этого образца.

    Почему не в Samples/Directory.Build.targets, общем для восьми: там прямым текстом
    записано «PackageContents.xml НЕ создаётся при сборке — User Panel генерирует его при
    установке», и для Bundle и PluginDll это ВЕРНО (BundleInstaller.cs:456,
    PackageContentsManager.CreateDefaultPackageContentsAsync:346). Для типа Msi установщик
    платформы не участвует вовсе — MSI пишет прямо в ApplicationPlugins, — поэтому манифест
    обязан существовать К МОМЕНТУ СБОРКИ. Это исключение по типу дистрибуции, а не отмена
    правила: ложное закрытие LGC-759 состояло ровно в том, что верное для двух типов
    свойство распространили на третий.

    AfterTargets="CreateBundleZip", а не CreateBundleStructure: ZIP собирается из каталога
    бандла, и порождение ДО архивации изменило бы состав ZIP. Он служит эталоном выпуска в
    тестах извлечения метаданных (build-samples.ps1:306), и менять его эта запись не просит.
  -->
  <!--
    Condition на TargetFramework — по ЗАМЕРУ, а не из осторожности. Без него цель отработала
    ДВАЖДЫ: сборка идёт внешним проходом (TargetFramework пуст, OutputPath = bin\Debug\) и
    внутренним, по TFM (bin\Debug\net8.0-windows\). Внешний создаёт каталог бандла и оставляет
    его ПУСТЫМ — 0 файлов, DLL кладёт только внутренний, — но общий Directory.Build.targets
    отрабатывает в обоих, и генератор писал манифест в том числе в пустышку. Вреда это не
    приносило (MSI читает каталог с TFM), но плодило второй манифест, ничего не описывающий.
  -->
  <Target Name="GenerateMsiBundleInputs" AfterTargets="CreateBundleZip" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <_MsiBundleDir>$(OutputPath)$(BundleName)</_MsiBundleDir>
      <_GenScript>MsiInstaller\generate-bundle-inputs.ps1</_GenScript>
    </PropertyGroup>

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_GenScript)&quot; -BundleDir &quot;$(_MsiBundleDir)&quot; -ProductDir &quot;.&quot; -Version &quot;$(Version)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
