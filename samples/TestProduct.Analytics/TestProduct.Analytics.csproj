<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TODO: Р вЂќР С•Р В±Р В°Р Р†Р С‘РЎвЂљРЎРЉ net48 Р С”Р С•Р С–Р Т‘Р В° AutoCAD 2024 Р В±РЎС“Р Т‘Р ВµРЎвЂљ РЎС“РЎРѓРЎвЂљР В°Р Р…Р С•Р Р†Р В»Р ВµР Р… -->
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
